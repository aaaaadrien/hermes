[llm]
# URL de base du serveur llama.cpp (compatible OpenAI)
base_url = http://localhost:8080/v1

# Clé API (inutile sur un inférence locale)
api_key = sk-no-key-required

# Nom du modèle (facultatif si llamacpp ou vLLM, masis nécessaire pour ollama)
model = default

# Nombre maximum de tokens
max_tokens = 65536

# Température
temperature = 0.7

[whisper]
# URL de base du serveur whisper.cpp
base_url = http://localhost:8081

# Route native de l'API whisper.cpp (PAS l'API de compatibilité OpenAI)
endpoint = /inference

# Format de réponse renvoyé par le serveur : json (recommandé), text, srt, vtt...
response_format = json

# Langue forcée pour la transcription (code ISO-639-1, laisser vide pour auto-détection)
language = fr

[video_url]
# Liste blanche des domaines autorisés pour outil_transcrire_video_url (yt-dlp), séparés par des virgules.
# Mettre "all" ou "*" pour désactiver la restriction et autoriser tous les sites (déconseillé).
domaines_autorises = youtube.com, twitch.tv, arte.tv

[image]
# URL de base du serveur stablediffusion.cpp (API compatible OpenAI /v1/images/generations)
base_url = http://localhost:8082

# Route de génération d'image
endpoint = /v1/images/generations

# Taille par défaut de l'image générée (LARGEURxHAUTEUR)
size = 512x512

# Nombre d'étapes de diffusion (laisser vide pour utiliser la valeur par défaut du serveur)
steps =

[audio]
# URL de base du serveur audio.cpp (API compatible OpenAI /v1/audio/speech)
base_url = http://localhost:8083

# Route de synthèse vocale (TTS)
endpoint = /v1/audio/speech

# Id du modèle TTS tel que configuré côté serveur audio.cpp (id)
model = qwen3-tts

# Voix à utiliser (dépend des voix disponibles sur le serveur audio.cpp, laisser vide pour la voix par défaut)
voice = Sohee

# Définit la langue en la forçant au modèle
language = fr

# Active/désactive le bouton "Écouter" dans l'interface web
tts = true

[agent]
# Prompt système 
system_prompt = Répond en français sauf avis contraire

[tools]
# Active ou désactive chaque outil individuellement (true / false)
enable_meteo              = true
enable_wiki               = false
enable_argent             = true
enable_duckduckgo         = true
enable_recup_page         = true
enable_datetime           = true
enable_generer_fichier    = true
enable_youtube_transcript = true
enable_transcrire_audio   = true
enable_generation_image   = true

[amphores]
# Disponibilité des amphores dans l'interface web :
# disabled : amphores non disponibles dans l'interface (défaut)
# user     : disponibles uniquement pour les utilisateurs authentifiés (nécessite [auth] authentification = userpass)
# all      : disponibles pour tout le monde, authentifié ou non
mode = disabled

# Mot de passe pour déverrouiller l'édition des amphores (commande /amphores <mdp> dans le chat).
# Laisser vide = édition toujours affichée par défaut (pas de protection).
editpasswd = MDP

[auth]
# authentification : permet de gérer l'authentification dans l'outil
# none    : pas de compte, mode éphémère, aucune conversation sauvegardée
# userpass: écran de connexion / création de compte, conversations sauvegardées dans hermes-users.db
authentification = none

# register : permet d'activer la création de compte ou non
# on  : l'onglet « Créer un compte » est affiché sur l'écran de connexion
# off : seul l'onglet « Connexion » est affiché (les comptes doivent être créés autrement)
register = off

[oidc]
# Active/désactive le bouton "Connexion SSO" sur l'écran de connexion.
# Nécessite [auth] authentification = userpass (l'OIDC vient en complément des comptes
# locaux, pas en remplacement : les deux boutons de connexion coexistent).
enabled = false

# URL de l'issuer OIDC (ex : Keycloak). Le document de découverte est lu automatiquement
# sur <issuer>/.well-known/openid-configuration.
issuer = https://sso.example.org/realms/mon-realm

client_id = hermes
client_secret = CHANGE_MOI

# URL de callback exacte, DOIT être enregistrée côté client OIDC (Keycloak, etc.)
# et correspondre à l'URL publique d'Hermes (ex : https://hermes.example.org/).
redirect_uri = http://localhost:8501/

# Scope OIDC, standard
scope = openid profile email

[web]
# Titre affiché dans l'onglet du navigateur
page_title = Hermes chatbot by Linuxtricks.fr
# Emoji dans la barre de titre
page_icon  = 📜
# Titre H1 de l'interface Streamlit
header     = Hermes chatbot by Linuxtricks.fr

[cli]
# Bannière d'accueil au démarrage
banner       = === HERMES PRÊT — Tapez 'exit' pour quitter ===
# Préfixes d'affichage dans la console
user_prefix  = Vous
agent_prefix = Hermes
